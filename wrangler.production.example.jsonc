{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentra-life-production",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-28",
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mentra-life-production",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-flash"
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
