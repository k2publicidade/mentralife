{
  "name": "mentra-life",
  "version": "12.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "start": "wrangler dev --ip 127.0.0.1 --port 8787",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "test:api": "node --test tests/platform-api.test.mjs",
    "prepare:vendor": "node scripts/prepare-vendor.mjs",
    "postinstall": "node scripts/prepare-vendor.mjs",
    "push:keys": "node scripts/generate-vapid.mjs",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "db:production": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "readiness": "node scripts/readiness.mjs",
    "prepare:deployment": "node scripts/prepare-deployment.mjs",
    "backup:export": "node scripts/private-backup.mjs export",
    "backup:decrypt": "node scripts/private-backup.mjs decrypt",
    "smoke:release": "node scripts/smoke-release.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "test:mobile": "node scripts/test-mobile-browser.mjs"
  },
  "description": "Mentra Life com Cloudflare Workers e D1",
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.6",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@tesseract.js-data/por": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  }
}
